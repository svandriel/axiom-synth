{
  "name": "@axiom/axiom-native",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "pkg"
  ],
  "scripts": {
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "build:wasm": "wasm-pack build ./rust --target web --out-dir ../pkg",
    "build:ts": "tsc -p tsconfig.app.json && tsc -p tsconfig.processor.json",
    "test": "cargo test --manifest-path rust/Cargo.toml"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "typescript": "^6.0.3"
  }
}
