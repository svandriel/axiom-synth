{
  "name": "axiom-synth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --sort build",
    "preview": "pnpm --filter @axiom/app preview",
    "test": "pnpm -r --parallel test",
    "lint": "prettier --check . && pnpm run lint:c",
    "lint:c": "find packages/native/c -type f \\( -name '*.c' -o -name '*.h' \\) -print0 | xargs -0 clang-format --dry-run --Werror",
    "format": "prettier --write . && pnpm run format:c",
    "format:c": "find packages/native/c -type f \\( -name '*.c' -o -name '*.h' \\) -print0 | xargs -0 clang-format -i",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
