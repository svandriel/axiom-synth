{
  "name": "axiom-synth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @axiom/app dev",
    "build": "pnpm -r --sort build",
    "build:pages": "pnpm --filter @axiom/axiom-native build && pnpm --filter @axiom/app build:pages",
    "preview": "pnpm --filter @axiom/app preview",
    "test": "pnpm --filter @axiom/audio-engine test",
    "test:native": "pnpm --filter @axiom/axiom-native test",
    "lint": "prettier --check .",
    "lint:native": "pnpm --filter @axiom/axiom-native lint",
    "format": "prettier --write .",
    "format:native": "pnpm --filter @axiom/axiom-native format",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
