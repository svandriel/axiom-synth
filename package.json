{
  "name": "axiom-synth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @axiom/app dev",
    "build": "pnpm -r --sort build",
    "build:pages": "pnpm --filter @axiom/app build:pages",
    "preview": "pnpm --filter @axiom/app preview",
    "test": "pnpm --filter @axiom/audio-engine test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2"
  }
}
